# Defense in depth for private data and generated files anywhere in the tree.
.DS_Store
**/__pycache__/
**/private/
**/signing/
**/.storage/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.log
*.pid
*.apk
*.idsig
*.zip
*.tar.gz

# Local account and pairing material must stay outside public snapshots.
**/tablet-config.json
**/tablet-voice-setup.json
**/device-token.txt
**/session.json
**/owner.json
**/credentials*.json
*.sqlite
*.sqlite3
*.db
