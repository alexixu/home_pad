# work/ also holds private configuration, device captures, firmware and caches.
# Only explicitly reviewed source files belong in the repository.
/work/*
!/work/tablet-paste.py
!/work/minimal-launcher/
!/work/homeassistant/
!/work/tablet-ha/
!/work/tablet-debloat/
!/work/root-prep/
!/work/unlock-feasibility/
!/work/voice-service/

/work/voice-service/*
!/work/voice-service/server.py
!/work/voice-service/configure.py
!/work/voice-service/config.example.json
!/work/voice-service/README.md
!/work/voice-service/test_server.py
!/work/voice-service/codex_backend.py
!/work/voice-service/test_codex_backend.py
!/work/voice-service/test_codex_catalog.py
!/work/voice-service/test_codex_http.py
!/work/voice-service/install_service.py
!/work/voice-service/test_install_service.py

/work/minimal-launcher/*
!/work/minimal-launcher/app/
!/work/minimal-launcher/build.py
!/work/minimal-launcher/toolchain.py
!/work/minimal-launcher/prepare_wake_dependencies.py
!/work/minimal-launcher/check_wake_word.py

/work/homeassistant/*
!/work/homeassistant/configure_tablet.py
!/work/homeassistant/env.sh
!/work/homeassistant/ha_session.py
!/work/homeassistant/provision_tablet_account.py
!/work/homeassistant/show_credentials.py
!/work/homeassistant/verify_socket_desktop.py

/work/tablet-ha/*
!/work/tablet-ha/transfer_server.py
!/work/tablet-ha/verify_local_service.py
!/work/tablet-ha/soak_monitor.py
!/work/tablet-ha/test_soak_monitor.py
!/work/tablet-ha/install_soak_monitor.py
!/work/tablet-ha/collect_soak_monitor.py
!/work/tablet-ha/test_collect_soak_monitor.py
!/work/tablet-ha/staging/
/work/tablet-ha/staging/*
!/work/tablet-ha/staging/start-tablet-ha
!/work/tablet-ha/staging/run-in-ha

/work/tablet-debloat/*
!/work/tablet-debloat/debloat.py
/work/root-prep/*
!/work/root-prep/stock-boot/
/work/root-prep/stock-boot/*
!/work/root-prep/stock-boot/extract_stock_boot.py
/work/unlock-feasibility/*
!/work/unlock-feasibility/analyze_settings.py

